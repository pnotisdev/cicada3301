work/ref/wulfic/
work/ref/outguessed/

# --- regenerable renders and scratch ---
work/pages/
work/figures/
work/tmp/

# --- build outputs ---
work/phpmt/target/
work/phpmt/target_gen/
work/walk/target/
**/__pycache__/
*.pyc
*.bak

